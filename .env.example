# Spring Profile (local or production)
SPRING_PROFILES_ACTIVE=local

# Database
DB_URL=jdbc:postgresql://localhost:5432/blog_local
DB_USERNAME=postgres
DB_PASSWORD=postgres

# GitHub OAuth App (Settings → Developer Settings → OAuth Apps)
# Callback URL (local): http://localhost:8080/blog/login/oauth2/code/github
# Callback URL (production): https://sevin.dev/api/blog/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# JWT (openssl rand -base64 64 으로 생성)
JWT_SECRET=your_jwt_secret_key_at_least_64_chars

# Admin
ADMIN_GITHUB_USERNAME=sevin98

# App
APP_BASE_URL=http://localhost:8080/blog
FRONTEND_URL=http://localhost:3000
